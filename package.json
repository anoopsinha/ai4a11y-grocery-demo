{
  "name": "ai4a11y-grocery-demo",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "A simulated grocery store for building AI for Accessibility Toolkit shopping adaptations. Real products from Open Food Facts; simulated prices and stock.",
  "scripts": {
    "start": "node server.js",
    "fetch": "node scripts/fetch-products.mjs",
    "counter": "node scripts/build-counter.mjs",
    "test": "node scripts/check-recipes.mjs && node scripts/check-assistant.mjs",
    "vendor": "sh scripts/vendor.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai4a11y/toolkit": "file:vendor/ai4a11y-toolkit.tgz"
  }
}
